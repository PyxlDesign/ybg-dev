        class="gp-flex variant-inside gp-flex-col gp-items-start {% if hiddenPresetOptions contains option.name %}gp-hidden{% endif %}"
        style="--mb: 16px;--minw-tablet:unset;--minw-mobile:unset;{% if forloop.last or option.name == last_option_name %}--mb:0;--mb-mobile:0;--mb-tablet:0;{% endif %}"
        >
          {%- assign showVariantClass = 'variant-display' -%}
          {%- assign optionName = option.name  -%}
          {% for preset in presets %}
            {%- assign presetDetail = preset | split: '($2)' -%}
            {% if presetDetail[1] == 'dropdown' and presetDetail[0] == optionName %}{%- assign showVariantClass = '' -%} {%- break -%}{% endif %}
