    "gp_section_633407305173763050": {
      "type": "gp-section-633407305173763050",
      "settings": {
        "checksum": "9ad67c6614a5af01b9c51953baeb7ffd02b6d4fff8d24c0c38a89ff93d991628_1_1_1_0__1",
        "ggQ8EGBmVDT_text": "Why Footrests Are The One Item Every Highchair Needs",
        "gg8ywnOKIwz_text": "<p>Longer, More Relaxed Meals</p>",
        "gg5h0c7fvoz_text": "<p>Without foot support, babies have to work hard to stay stable. This leads to short, fussy meals. When a footrest is added, babies can sit longer and often show a greater interest in eating.&nbsp;</p>",
        "ggSpxz1sCKM_text": "<p>Improves Fine Motor Skills</p>",
        "gg87BzFOJbN_text": "<p>Stable, comfortable babies can focus on fine motor skills like picking up food, chewing and swallowing</p>",
        "ggfT4nPWNHJ_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0306/4076/7108/files/Desert_Sage_Lifestyle9_JKP_SS.jpg",
        "ggN7OzTADaU_text": "<p>Decreases Choking Risk</p>",
        "ggazOuuojLV_text": "<p>Foot support and trunk stability help facilitate a safe swallow</p>",
        "ggVlObnfEgO_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0306/4076/7108/files/untitled-436_JKP_SS_square_27e0788f-687c-4bc1-a119-05d3fd865d64.jpg"
      }
