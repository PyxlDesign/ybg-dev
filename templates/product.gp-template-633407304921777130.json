    "gp_section_633407305173959658": {
      "type": "gp-section-633407305173959658",
      "settings": {
        "checksum": "de6819d54a6dd751644820e68400e8168b068667429e508008d3695259154977_1_1_1_0__1",
        "gg9KWB8qIMd_text": "<p>The number one thing I recommend in a highchair is foot support. It's key to a productive meal time experience.</p>",
